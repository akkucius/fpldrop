# Copy this file to .env and fill in your values.
# Never commit .env.

# FPL team ID from fantasy.premierleague.com/entry/THIS_NUMBER/
FPL_MANAGER_ID=4703066

# Needed before the gameweek deadline. After deadline, public picks work without it.
# Copy access_token from the FPL site (oidc.user in DevTools). Use access_token, not id_token.
# In the FPL tab console:
# JSON.parse(localStorage.getItem("oidc.user:https://account.premierleague.com/as:bfcbaf69-aade-4c1b-8f00-c1cb8a193030")).access_token
FPL_ACCESS_TOKEN=
FPL_REFRESH_TOKEN=

# Optional. Defaults to the official FPL web app client id.
# FPL_OIDC_CLIENT_ID=bfcbaf69-aade-4c1b-8f00-c1cb8a193030

# X (Twitter) for now. Not needed for dry-run:
# .venv/Scripts/python.exe -m fpl_x publish --dry-run
# Developer Portal, your app, Keys and tokens, OAuth 1.0a, Read and Write.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
